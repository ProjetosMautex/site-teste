---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import BlogCard from '../components/BlogCard';

const posts = [
  {
    title: "Unboxing da Parafusadeira e Furadeira 2 em 1 Britânia Hobby BPF-03 MF",
    excerpt: "O unboxing da parafusadeira e furadeira 2 em 1 Britânia, modelo BPF-03 MF, da linha Hobby, revela uma ferramenta compacta e versátil, ideal para quem busca praticidade em tarefas domésticas.",
    date: "28 de Maio, 2026",
    url: "/blog/teste1",
    featured: true
  },
  {
    title: "Produto não condiz com a descrição e bateria não carrega",
    excerpt: "Receber um produto que não corresponde à descrição prometida é frustrante. Quando a bateria do item não carrega, o problema se agrava, tornando o uso inviável.",
    date: "28 de Maio, 2026",
    url: "/blog/teste2",
    featured: false
  },
  {
    title: "Parafusadeira Britânia Hobby BPF03 com queda de potência e inoperante mesmo com bateria carregada, dentro da garantia",
    excerpt: "Se você está enfrentando queda de potência na parafusadeira Britânia Hobby BPF03, mesmo com a bateria totalmente carregada, verifique as dicas antes de buscar assistência.",
    date: "28 de Maio, 2026",
    url: "/blog/teste3",
    featured: false
  },
  {
    title: "Parafusadeira Britânia BPF01 4,8V e 11 Bits - Bivolt - Vícios Ocultos",
    excerpt: "A Parafusadeira Britânia BPF01 4,8V é uma ferramenta prática e funcional, ideal para tarefas leves e uso doméstico, mas fique atento aos vícios ocultos.",
    date: "28 de Maio, 2026",
    url: "/blog/teste4",
    featured: false
  }
];
---

<Layout title="Blog - AstroBun Test Site">
  <Navbar client:load />
  
  <main className="blog-page">
    <section className="blog-hero">
      <div className="container">
        <h1 className="animate-fade">Nosso <span>Blog</span></h1>
        <p className="animate-fade" style="animation-delay: 0.2s">Dicas, reviews e guias práticos sobre ferramentas e manutenção.</p>
      </div>
    </section>

    <section className="blog-content">
      <div className="container">
        <div className="posts-grid">
          {posts.map(post => (
            <BlogCard {...post} client:visible />
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div className="container footer-content">
      <p>&copy; 2026 AstroBun Test Site. Desenvolvido com Antigravity.</p>
    </div>
  </footer>

  <style>
    .blog-page {
      padding-top: 80px;
    }

    .blog-hero {
      padding: 6rem 0 4rem;
      text-align: center;
      background: radial-gradient(circle at center, rgba(99, 102, 241, 0.1) 0%, transparent 70%);
    }

    h1 {
      font-size: 4rem;
      margin-bottom: 1.5rem;
    }

    h1 span {
      background: linear-gradient(to right, var(--primary), var(--accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .blog-hero p {
      font-size: 1.25rem;
      color: var(--text-muted);
      max-width: 600px;
      margin: 0 auto;
    }

    .blog-content {
      padding: 4rem 0 8rem;
    }

    .posts-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }

    footer {
      padding: 4rem 0;
      border-top: 1px solid var(--glass-border);
      text-align: center;
      color: var(--text-muted);
      font-size: 0.875rem;
    }

    @media (max-width: 768px) {
      h1 {
        font-size: 2.5rem;
      }
      
      .posts-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
