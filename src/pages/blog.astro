---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import BlogCard from '../components/BlogCard';

const posts = [
  {
    title: "Avaliação da Nova Ferramenta Elétrica para Obras Residenciais",
    excerpt: "Recentemente adquiri uma nova ferramenta elétrica destinada a realizar diversos serviços de construção civil em minha residência. Trata-se de um martelete potente com excelente custo-benefício.",
    date: "24 de Junho, 2026",
    url: "/blog/teste1",
    featured: true
  },
  {
    title: "Reforma no Fundo de Casa: Planejamento e Execução da Obra",
    excerpt: "Uma reforma eficiente no fundo de casa começa com um planejamento detalhado que inclui a definição clara do objetivo, orçamento e prazos.",
    date: "24 de Junho, 2026",
    url: "/blog/teste2",
    featured: false
  },
  {
    title: "Análise Completa do Martelete a Bateria Dobev 12 V por R$ 189",
    excerpt: "Análise e testes práticos do martelete rotativo sem fio Dobev de 12 V com duas baterias, carregador e kit completo de brocas, bits e adaptadores.",
    date: "24 de Junho, 2026",
    url: "/blog/teste3",
    featured: false
  },
  {
    title: "Apresentação e Análise do Kit de Ferramentas da Marca BEV",
    excerpt: "Review e teste detalhado do kit com martelete, esmerilhadeira de 3 velocidades, baterias de 3 Ah e adaptador de motosserra importados e nacionalizados.",
    date: "24 de Junho, 2026",
    url: "/blog/teste4",
    featured: false
  }
];
---

<Layout title="Blog - AstroBun Test Site">
  <Navbar client:load />
  
  <main className="blog-page">
    <section className="blog-hero">
      <div className="container">
        <h1 className="animate-fade">Nosso <span>Blog</span></h1>
        <p className="animate-fade" style="animation-delay: 0.2s">Dicas, reviews e guias práticos sobre ferramentas e manutenção.</p>
      </div>
    </section>

    <section className="blog-content">
      <div className="container">
        <div className="posts-grid">
          {posts.map(post => (
            <BlogCard {...post} client:visible />
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div className="container footer-content">
      <p>&copy; 2026 AstroBun Test Site. Desenvolvido com Antigravity.</p>
    </div>
  </footer>

  <style>
    .blog-page {
      padding-top: 80px;
    }

    .blog-hero {
      padding: 6rem 0 4rem;
      text-align: center;
      background: radial-gradient(circle at center, rgba(99, 102, 241, 0.1) 0%, transparent 70%);
    }

    h1 {
      font-size: 4rem;
      margin-bottom: 1.5rem;
    }

    h1 span {
      background: linear-gradient(to right, var(--primary), var(--accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .blog-hero p {
      font-size: 1.25rem;
      color: var(--text-muted);
      max-width: 600px;
      margin: 0 auto;
    }

    .blog-content {
      padding: 4rem 0 8rem;
    }

    .posts-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }

    footer {
      padding: 4rem 0;
      border-top: 1px solid var(--glass-border);
      text-align: center;
      color: var(--text-muted);
      font-size: 0.875rem;
    }

    @media (max-width: 768px) {
      h1 {
        font-size: 2.5rem;
      }
      
      .posts-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
