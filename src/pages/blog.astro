---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import BlogCard from '../components/BlogCard';

const posts = [
  {
    title: "Comparativo Entre Furadeiras Bosch e Nakasaki: Análise de Desempenho e Custo-Benefício",
    excerpt: "Realizar um comparativo entre as furadeiras Bosch e Nakasaki envolve analisar aspectos como desempenho, qualidade, acessórios e custo-benefício, considerando o público-alvo, seja profissional ou uso doméstico.",
    date: "31 de Maio, 2026",
    url: "/blog/teste1",
    featured: true
  },
  {
    title: "Martelete Nakasaki 1200 W: Análise Completa e Funcionalidades",
    excerpt: "O Martelete Nakasaki 1200 W é uma ferramenta versátil e poderosa, ideal para quem precisa de eficiência em perfurações e rompimentos em materiais diversos, como concreto, alvenaria e pedra.",
    date: "31 de Maio, 2026",
    url: "/blog/teste2",
    featured: false
  },
  {
    title: "Avaliação do Martelo Rompedor Nakasaki: Teste Completo e Veredito Final",
    excerpt: "O Martelo Rompedor Nakasaki se destaca pela robustez e eficiência em tarefas pesadas de demolição. Com um desempenho consistente, ele apresenta alta potência de impacto.",
    date: "31 de Maio, 2026",
    url: "/blog/teste3",
    featured: false
  },
  {
    title: "Apresentação do Martelete Rotatório 12 Peças Nakasaki",
    excerpt: "Apresentamos o martelete rotatório de 12 peças da Nakasaki, comprado pelo menor preço encontrado no Mercado Livre. Esta ferramenta se destaca pela combinação de potência e versatilidade.",
    date: "31 de Maio, 2026",
    url: "/blog/teste4",
    featured: false
  },
  {
    title: "Avaliação da Furadeira Britânia Adquirida na Shopee",
    excerpt: "A furadeira da marca Britânia, adquirida recentemente na Shopee, apresenta um bom custo-benefício para quem precisa de uma ferramenta básica para uso doméstico.",
    date: "31 de Maio, 2026",
    url: "/blog/teste5",
    featured: false
  }
];
---

<Layout title="Blog - AstroBun Test Site">
  <Navbar client:load />
  
  <main className="blog-page">
    <section className="blog-hero">
      <div className="container">
        <h1 className="animate-fade">Nosso <span>Blog</span></h1>
        <p className="animate-fade" style="animation-delay: 0.2s">Dicas, reviews e guias práticos sobre ferramentas e manutenção.</p>
      </div>
    </section>

    <section className="blog-content">
      <div className="container">
        <div className="posts-grid">
          {posts.map(post => (
            <BlogCard {...post} client:visible />
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div className="container footer-content">
      <p>&copy; 2026 AstroBun Test Site. Desenvolvido com Antigravity.</p>
    </div>
  </footer>

  <style>
    .blog-page {
      padding-top: 80px;
    }

    .blog-hero {
      padding: 6rem 0 4rem;
      text-align: center;
      background: radial-gradient(circle at center, rgba(99, 102, 241, 0.1) 0%, transparent 70%);
    }

    h1 {
      font-size: 4rem;
      margin-bottom: 1.5rem;
    }

    h1 span {
      background: linear-gradient(to right, var(--primary), var(--accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .blog-hero p {
      font-size: 1.25rem;
      color: var(--text-muted);
      max-width: 600px;
      margin: 0 auto;
    }

    .blog-content {
      padding: 4rem 0 8rem;
    }

    .posts-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }

    footer {
      padding: 4rem 0;
      border-top: 1px solid var(--glass-border);
      text-align: center;
      color: var(--text-muted);
      font-size: 0.875rem;
    }

    @media (max-width: 768px) {
      h1 {
        font-size: 2.5rem;
      }
      
      .posts-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
