---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import BlogCard from '../components/BlogCard';

const posts = [
  {
    title: "Kit de Brocas de Titânio: Solução Completa para Madeira, Metal, Concreto e Porcelanato",
    excerpt: "O kit de brocas de titânio é uma solução versátil e eficiente para profissionais que atuam com diversos tipos de materiais. Desenvolvido para garantir praticidade e alta performance.",
    date: "31 de Maio, 2026",
    url: "/blog/teste1",
    featured: true
  },
  {
    title: "Brocas de titânio, vale a pena ou é só uma furada?",
    excerpt: "Trabalho em um café e sou responsável por grande parte da manutenção básica. Utilizamos um moedor Mazzer Robur S e está chegando o momento de trocar as lâminas.",
    date: "31 de Maio, 2026",
    url: "/blog/teste2",
    featured: false
  },
  {
    title: "Broca de Titânio: a solução que fura tudo!",
    excerpt: "A broca de titânio é uma ferramenta versátil que promete perfurar diversos tipos de materiais, como madeira, concreto e metal, sem a necessidade de trocar o equipamento constantemente.",
    date: "31 de Maio, 2026",
    url: "/blog/teste3",
    featured: false
  },
  {
    title: "Furadeira Martelete Impacto 3/8 650W Britânia - BFU01 é boa?",
    excerpt: "A Furadeira Martelete Impacto 3/8 650W Britânia - BFU01 é uma ferramenta versátil e eficiente, indicada para pequenos e médios reparos em casa ou no trabalho.",
    date: "31 de Maio, 2026",
    url: "/blog/teste4",
    featured: false
  },
  {
    title: "Avaliação da Furadeira Britânia Adquirida na Shopee",
    excerpt: "A furadeira da marca Britânia, adquirida recentemente na Shopee, apresenta um bom custo-benefício para quem precisa de uma ferramenta básica para uso doméstico.",
    date: "31 de Maio, 2026",
    url: "/blog/teste5",
    featured: false
  }
];
---

<Layout title="Blog - AstroBun Test Site">
  <Navbar client:load />
  
  <main className="blog-page">
    <section className="blog-hero">
      <div className="container">
        <h1 className="animate-fade">Nosso <span>Blog</span></h1>
        <p className="animate-fade" style="animation-delay: 0.2s">Dicas, reviews e guias práticos sobre ferramentas e manutenção.</p>
      </div>
    </section>

    <section className="blog-content">
      <div className="container">
        <div className="posts-grid">
          {posts.map(post => (
            <BlogCard {...post} client:visible />
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div className="container footer-content">
      <p>&copy; 2026 AstroBun Test Site. Desenvolvido com Antigravity.</p>
    </div>
  </footer>

  <style>
    .blog-page {
      padding-top: 80px;
    }

    .blog-hero {
      padding: 6rem 0 4rem;
      text-align: center;
      background: radial-gradient(circle at center, rgba(99, 102, 241, 0.1) 0%, transparent 70%);
    }

    h1 {
      font-size: 4rem;
      margin-bottom: 1.5rem;
    }

    h1 span {
      background: linear-gradient(to right, var(--primary), var(--accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .blog-hero p {
      font-size: 1.25rem;
      color: var(--text-muted);
      max-width: 600px;
      margin: 0 auto;
    }

    .blog-content {
      padding: 4rem 0 8rem;
    }

    .posts-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }

    footer {
      padding: 4rem 0;
      border-top: 1px solid var(--glass-border);
      text-align: center;
      color: var(--text-muted);
      font-size: 0.875rem;
    }

    @media (max-width: 768px) {
      h1 {
        font-size: 2.5rem;
      }
      
      .posts-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
